<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html>
<html>
<head>
    <title>결제 입력 페이지</title>
    <link rel="stylesheet" type="text/css" href="/WEB-INF/include/style.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://ssl.daumcdn.net/dmaps/map_js_init/postcode.v2.js"></script>
    <style>
        body {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            background-color: var(--light-bg);
        }
        h2 {
            text-align: center;
            color: var(--text-color);
        }
        form {
            background-color: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
        label {
            font-weight: bold;
            display: block;
            margin-top: 15px;
        }
        input[type="text"],
        input[type="number"],
        textarea,
        select {
            width: calc(100% - 20px);
            padding: 8px;
            margin-top: 5px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
        input[readonly] {
            background-color: #f0f0f0;
            font-weight: bold;
        }
        button,
        input[type="submit"] {
            padding: 10px 20px;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        button {
            background-color: var(--secondary-color);
            margin-top: 10px;
        }
        button:hover {
            background-color: darken(var(--secondary-color), 10%);
        }
        input[type="submit"] {
            width: 100%;
            background-color: var(--primary-color);
            margin-top: 20px;
        }
        input[type="submit"]:hover {
            background-color: darken(var(--primary-color), 10%);
        }
        #totalAmount {
            text-align: center;
            font-size: 1.2em;
            color: #d9534f;
            margin-top: 15px;
        }
    </style>
    <script>
        // 카카오톡 주소 검색 기능
        function searchAddress() {
            new daum.Postcode({
                oncomplete: function(data) {
                    // 사용자가 선택한 주소 값을 가져옵니다.
                    document.getElementById("address").value = data.address;
                    document.getElementById("addressDetail").value = ""; // 상세 주소 초기화
                    document.getElementById("addressDetail").focus(); // 상세 주소 입력 칸에 포커스 이동
                }
            }).open();
        }

        function calculateTotal() {
            const price = parseInt(document.getElementById('price').value);
            const quantity = parseInt(document.getElementById('quantity').value);
            let points = parseInt(document.getElementById('points').value);
            const coupon = document.getElementById('coupon').value;

            // 기본 가격 계산 (상품 가격 * 수량)
            let total = price * quantity;

            // 포인트 사용
            if (!isNaN(points)) {
                total -= points;
            }

            // 쿠폰 할인 적용
            if (coupon === "포인트 쿠폰") {
                total *= 0.9; // 10% 할인
            } else if (coupon === "친구추가 쿠폰") {
                total -= 3000; // 3000원 할인
            } else if (coupon === "다운로드 쿠폰") {
                total -= 5000; // 5000원 할인
            }

            // 배송비 (기본 3000원)
            const shippingFee = 3000;
            total += shippingFee;

            // 총 결제 금액 갱신
            document.getElementById('totalAmount').innerText = "총 결제 금액: " + Math.max(total, 0) + "원";
        }
    </script>
</head>
<body>
    <h2>결제 입력 페이지</h2>
    <form action="paymentComplete.jsp" method="post" oninput="calculateTotal()">
        <!-- 상품 정보 -->
        <label for="product">상품명:</label>
        <input type="text" id="product" name="product" value="상품 이름" readonly><br><br>

        <label for="price">상품 가격:</label>
        <input type="text" id="price" name="price" value="10000" readonly> 원<br><br>

        <label for="quantity">수량:</label>
        <input type="number" id="quantity" name="quantity" value="1" min="1"><br><br>

        <!-- 사용자 정보 -->
        <label for="name">이름:</label>
        <input type="text" id="name" name="name" required><br><br>

        <label for="phone">전화번호:</label>
        <input type="text" id="phone" name="phone" required><br><br>

        <label for="address">주소:</label>
        <input type="text" id="address" name="address" required>
        <button type="button" onclick="searchAddress()">주소 검색</button><br><br>

        <label for="addressDetail">상세 주소:</label>
        <input type="text" id="addressDetail" name="addressDetail" required><br><br>

        <label for="deliveryRequest">배송 요청사항:</label>
        <textarea id="deliveryRequest" name="deliveryRequest" rows="3" cols="30"></textarea><br><br>

        <!-- 결제 정보 -->
        <label for="coupon">쿠폰 선택:</label>
        <select id="coupon" name="coupon">
            <option value="">쿠폰 없음</option>
            <option value="포인트 쿠폰">포인트 쿠폰 (10% 할인)</option>
            <option value="친구추가 쿠폰">친구추가 쿠폰 (3000원 할인)</option>
            <option value="다운로드 쿠폰">다운로드 쿠폰 (5000원 할인)</option>
        </select><br><br>

        <label for="points">포인트 사용:</label>
        <input type="number" id="points" name="points" min="0" step="100" value="0"><br><br>

        <!-- 총 결제 금액 -->
        <h3 id="totalAmount">총 결제 금액: 10000원</h3>

        <!-- 결제 방법 선택 -->
        <label for="paymentMethod">결제 방법:</label><br>
        <label for="cardPayment">
            <input type="radio" id="cardPayment" name="paymentMethod" value="카드결제" required> 카드 결제
        </label><br>
        <label for="easyPayment">
            <input type="radio" id="easyPayment" name="paymentMethod" value="네이버 간편결제" required> 네이버 간편결제
        </label><br>

        <!-- 결제하기 버튼 -->
        <input type="submit" value="결제하기">
    </form>

    <script>
        // 카드 결제 및 네이버 간편결제와 관련된 결제 API는 서버측 스크립트와 연동 필요
        $(document).on('submit', 'form', function(event) {
            event.preventDefault();
            const paymentMethod = $("input[name='paymentMethod']:checked").val();
            
            if (paymentMethod === "카드결제") {
                // 카드 결제 API 호출
                alert("카드 결제 API 호출 중...");
                // 카드 결제 관련 로직 추가
            } else if (paymentMethod === "네이버 간편결제") {
                // 네이버 간편결제 API 호출
                alert("네이버 간편결제 API 호출 중...");
                // 네이버 결제 관련 로직 추가
            }
        });
    </script>
    
    
</body>
</html>
